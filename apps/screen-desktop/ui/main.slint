import { AboutSlint, Button, ComboBox, ScrollView, Slider } from "std-widgets.slint";

component ValueRow inherits Rectangle {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> numeric-minimum: root.minimum;
    in property <float> numeric-maximum: root.maximum;
    in property <float> step;
    in-out property <float> value;
    in property <string> numeric-value;
    in property <string> suffix;
    in property <bool> enabled: true;
    private property <string> edit-text: root.numeric-value;
    private property <bool> input-focused: value-input.has-focus;

    changed numeric-value => {
        if (!root.input-focused) {
            root.edit-text = root.numeric-value;
        }
    }
    changed input-focused => {
        if (!root.input-focused) {
            if (root.edit-text.is-float()) {
                root.value = clamp(root.edit-text.to-float(), root.numeric-minimum, root.numeric-maximum);
            }
            root.edit-text = root.numeric-value;
        }
    }

    height: 38px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;

        Text {
            text: root.label;
            color: root.enabled ? #aeb7c8 : #697386;
            width: 84px;
            vertical-alignment: center;
        }

        Slider {
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            value <=> root.value;
            width: 124px;
            enabled: root.enabled;
        }

        Rectangle {
            width: 70px;
            height: 30px;
            border-radius: 4px;
            border-width: 1px;
            border-color: value-input.has-focus ? #6aa1ff : #454d5c;
            background: #252b35;

            value-input := TextInput {
                x: 5px;
                y: 1px;
                width: parent.width - (root.suffix == "" ? 10px : 30px);
                height: parent.height - 2px;
                text <=> root.edit-text;
                enabled: root.enabled;
                color: #e6ebf3;
                selection-background-color: #3677d7;
                selection-foreground-color: #ffffff;
                horizontal-alignment: right;
                vertical-alignment: center;
                single-line: true;
                accepted => {
                    if (self.text.is-float()) {
                        root.value = clamp(self.text.to-float(), root.numeric-minimum, root.numeric-maximum);
                    }
                    root.edit-text = root.numeric-value;
                }
            }

            Text {
                text: root.suffix;
                visible: root.suffix != "";
                x: parent.width - 22px;
                width: 18px;
                height: parent.height;
                color: #8490a3;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Screen Simulation";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1080px;
    min-height: 680px;
    background: #0d1015;
    forward-focus: key-handler;

    in-out property <float> white-nits: 600;
    in-out property <float> gamma: 2.2;
    in-out property <float> black-matrix: 0.12;
    in-out property <float> panel-flicker-percent: 0.2;
    in-out property <float> panel-flicker-hz: 240;
    in-out property <float> panel-banding-amount: 0;
    in-out property <float> panel-banding-hz: 960;
    in-out property <float> panel-banding-duty-percent: 50;
    in-out property <float> distance-m: 0.82;
    in-out property <float> focal-mm: 50;
    in-out property <float> focus-distance-m: 0.82;
    in-out property <float> f-stop: 8;
    in-out property <float> preview-exposure-ev: 6;
    in-out property <float> white-balance-r: 1;
    in-out property <float> white-balance-g: 1;
    in-out property <float> white-balance-b: 1;
    in-out property <float> camera-exposure-ev: 0;
    in-out property <float> capture-exposure-index: 800;
    in-out property <float> shutter-angle-degrees: 180;
    in-out property <float> temporal-samples: 1;
    in-out property <int> sensor-readout-index: 1;
    in-out property <float> readout-duration-ms: 7.8;
    in-out property <float> sensor-noise-seed: 42;
    in-out property <float> neutral-density-stops: 0;
    in-out property <int> output-transform-index: 0;
    in-out property <int> capture-preset-index: 0;
    in property <[string]> capture-preset-model;
    in property <[string]> capture-preset-ids;
    in-out property <float> capture-sensor-width: 4608;
    in-out property <float> capture-sensor-height: 3164;
    in-out property <float> capture-gate-width-mm: 27.99;
    in-out property <float> capture-gate-height-mm: 19.22;
    in-out property <string> capture-summary: "Published ALEV 4 geometry · reference 50 mm lens";
    in-out property <bool> capture-fixed-optics: false;
    in-out property <int> lens-preset-index: 3;
    in property <[string]> lens-preset-model;
    in property <[string]> lens-preset-ids;
    in-out property <string> lens-summary: "Generic photographic approximation";
    in-out property <int> cover-preset-index: 0;
    in property <[string]> cover-preset-model;
    in property <[string]> cover-preset-ids;
    in-out property <string> cover-summary: "0.75 mm · IOR 1.52 · roughness 0.03";
    in-out property <float> cover-strength: 1;
    in-out property <float> panel-character-strength: 1;
    in-out property <float> lens-character-strength: 1;
    in-out property <int> environment-preset-index: 0;
    in property <[string]> environment-preset-model;
    in property <[string]> environment-preset-ids;
    in-out property <string> environment-summary: "Synthetic latitude-longitude HDR · linear ACEScg";
    in-out property <float> environment-strength: 1;
    in-out property <float> environment-rotation-x-degrees: 0;
    in-out property <float> environment-rotation-y-degrees: 0;
    in-out property <int> render-quality-index: 1;
    in-out property <bool> capture-rendering: false;
    in-out property <bool> preview-rendering: false;
    in-out property <bool> preview-invalidated: false;
    in-out property <bool> render-progress-visible: false;
    in-out property <float> render-progress: 0;
    in-out property <string> render-progress-label: "";
    in-out property <float> preview-aspect: 1.5;
    in-out property <int> device-preset-index: 3;
    in property <[string]> device-preset-model;
    in property <[string]> device-preset-ids;
    in-out property <int> color-mode-index: 0;
    in property <[string]> color-mode-model;
    in-out property <float> device-native-width: 3024;
    in-out property <float> device-native-height: 1964;
    in-out property <float> device-active-width-mm: 302.4;
    in-out property <float> device-active-height-mm: 196.4;
    in-out property <string> device-summary: "14.2 in · 254.0 PPI · 0.100 mm pitch";
    in-out property <float> device-reference-white-nits: 500;
    in-out property <string> device-white-basis: "Published SDR reference";
    in property <string> build-id: "development";
    in-out property <int> focus-mode-index: 0;
    in-out property <float> yaw-degrees: 0;
    in-out property <float> pitch-degrees: 0;
    in-out property <int> camera-key-count: 1;
    in-out property <int> camera-interpolation-index: 2;
    in-out property <int> stripe-index: 0;
    in-out property <int> view-index: 0;
    in-out property <bool> playing: false;
    in-out property <int> frame-number: 0;
    in-out property <image> preview-image;
    in-out property <image> native-level-0-image;
    in-out property <image> native-level-1-image;
    in-out property <image> native-level-2-image;
    in-out property <image> native-level-3-image;
    in-out property <float> native-source-width: 1;
    in-out property <bool> native-pyramid-ready: false;
    in-out property <image> native-staging-image;
    in-out property <bool> native-staging-ready: false;
    in-out property <bool> native-capture-ready: false;
    in-out property <bool> native-capture-stale: false;
    in-out property <string> scale-text: "PREVIEW —";
    in-out property <string> render-text: "Preparing physical preview…";
    in-out property <string> inspection-text: "FIT · MAIN CAMERA";
    in-out property <string> hint-text: "Hold Z and drag · physical inspection camera";
    in-out property <string> error-text: "";
    in-out property <string> source-title: "Procedural diagnostic";
    in-out property <string> source-details: "3840 × 2160 · authored diagnostic";
    in-out property <string> source-interpretation: "Explicit device signal";
    in-out property <int> placement-index: 0;
    in-out property <int> idt-index: 0;
    in property <[string]> idt-model;
    in-out property <int> alpha-index: 0;
    in-out property <int> matrix-index: 0;
    in-out property <int> range-index: 0;
    in-out property <int> sample-policy-index: 1;
    in-out property <int> project-fps-index: 1;
    in-out property <int> custom-fps-numerator: 24;
    in-out property <int> custom-fps-denominator: 1;
    in-out property <int> procedural-pattern-index: 0;
    in-out property <bool> procedural-source: true;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <bool> camera-edit-pending: false;
    in-out property <float> viewer-zoom: 1;
    in-out property <float> viewer-pan-x: 0;
    in-out property <float> viewer-pan-y: 0;
    private property <bool> zoom-key-held: false;
    private property <float> pan-start-x: 0;
    private property <float> pan-start-y: 0;

    callback inspect(float, float, float, float);
    callback reset-inspection();
    callback tick();
    callback choose-source();
    callback set-camera-keyframe();
    callback undo();
    callback redo();
    callback select-device-preset(string);
    callback select-capture-preset(string);
    callback select-lens-preset(string);
    callback select-cover-preset(string);
    callback select-environment-preset(string);
    callback render-capture-frame();
    callback cancel-capture-frame();
    callback export-native-frame();
    callback continue-preview-render();
    callback select-render-quality(int);

    MenuBar {
        Menu {
            title: "Edit";

            MenuItem {
                title: "Undo";
                enabled: root.can-undo;
                shortcut: @keys(Control + Z);
                activated => { root.undo(); }
            }

            MenuItem {
                title: "Redo";
                enabled: root.can-redo;
                shortcut: @keys(Control + Shift + Z);
                activated => { root.redo(); }
            }
        }

        Menu {
            title: "Help";

            MenuItem {
                title: "About Screen Simulation…";
                activated => {
                    about-popup.show();
                }
            }

        }
    }

    Timer {
        // CPU optical reference evaluation leaves event-loop time between deterministic frames.
        interval: 250ms;
        running: true;
        triggered => {
            root.tick();
        }
    }

    about-popup := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 430px;
        height: 320px;
        close-policy: PopupClosePolicy.no-auto-close;

        Rectangle {
            background: #151922;
            border-width: 1px;
            border-color: #465064;
            border-radius: 8px;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                alignment: center;

                Text {
                    text: "SCREEN SIMULATION";
                    color: #e7edf7;
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Version 0.1.0 · Build " + root.build-id;
                    color: #aeb7c8;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Rust · Slint · WGPU\nMetal on macOS · Direct3D 12 on Windows";
                    color: #7f8da4;
                    horizontal-alignment: center;
                }

                AboutSlint {
                    height: 92px;
                }

                Button {
                    text: "Close";
                    clicked => {
                        about-popup.close();
                    }
                }
            }
        }
    }

    key-handler := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape || ((event.text == "z" || event.text == "Z") && event.modifiers.shift)) {
                root.zoom-key-held = false;
                root.reset-inspection();
                return accept;
            }
            if (event.text == "z" || event.text == "Z") {
                root.zoom-key-held = true;
                return accept;
            }
            return reject;
        }

        capture-key-released(event) => {
            if (event.text == "z" || event.text == "Z") {
                root.zoom-key-held = false;
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 54px;
                background: #141820;
                border-width: 1px;
                border-color: #2a303b;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 12px;

                    Text {
                        text: "SCREEN SIMULATION";
                        color: #e7edf7;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "PHYSICAL LCD";
                        color: #6aa1ff;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: root.render-text;
                        color: #98a4b8;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;

                Rectangle {
                    background: #090c10;
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 24px;
                            spacing: 8px;

                            Text {
                                text: "PHYSICAL CAMERA PREVIEW";
                                color: #b8c4d8;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Button {
                                text: "Fit";
                                clicked => {
                                    root.viewer-zoom = 1;
                                    root.viewer-pan-x = 0;
                                    root.viewer-pan-y = 0;
                                }
                            }

                            Button {
                                text: "1:1 Sensor";
                                clicked => {
                                    root.viewer-zoom = clamp(root.native-pyramid-ready ? root.native-source-width * 1px / preview.width : root.preview-image.width * 1px / preview.width, 1, 8);
                                    root.viewer-pan-x = 0;
                                    root.viewer-pan-y = 0;
                                }
                            }

                            Slider {
                                minimum: 1;
                                maximum: 8;
                                step: 0.25;
                                value <=> root.viewer-zoom;
                                width: 100px;
                            }

                            Text {
                                text: round(root.viewer-zoom * 100) / 100 + "×";
                                color: #aeb7c8;
                                width: 38px;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: root.inspection-text + " · " + root.scale-text;
                                color: #78a8f4;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        preview := Rectangle {
                            height: self.width / root.preview-aspect;
                            clip: true;
                            background: #06080b;
                            border-width: 1px;
                            border-color: #313947;

                            Image {
                                visible: !root.native-pyramid-ready;
                                source: root.preview-image;
                                width: parent.width * root.viewer-zoom;
                                height: parent.height * root.viewer-zoom;
                                x: -(self.width - parent.width) / 2 + root.viewer-pan-x * parent.width;
                                y: -(self.height - parent.height) / 2 + root.viewer-pan-y * parent.height;
                                image-fit: fill;
                            }

                            Image {
                                visible: root.native-pyramid-ready && root.viewer-zoom >= (root.native-source-width * 1px / preview.width) * 0.75;
                                source: root.native-level-0-image;
                                width: parent.width * root.viewer-zoom;
                                height: parent.height * root.viewer-zoom;
                                x: -(self.width - parent.width) / 2 + root.viewer-pan-x * parent.width;
                                y: -(self.height - parent.height) / 2 + root.viewer-pan-y * parent.height;
                                image-fit: fill;
                            }

                            Image {
                                visible: root.native-pyramid-ready && root.viewer-zoom < (root.native-source-width * 1px / preview.width) * 0.75 && root.viewer-zoom >= (root.native-source-width * 1px / preview.width) * 0.375;
                                source: root.native-level-1-image;
                                width: parent.width * root.viewer-zoom;
                                height: parent.height * root.viewer-zoom;
                                x: -(self.width - parent.width) / 2 + root.viewer-pan-x * parent.width;
                                y: -(self.height - parent.height) / 2 + root.viewer-pan-y * parent.height;
                                image-fit: fill;
                            }

                            Image {
                                visible: root.native-pyramid-ready && root.viewer-zoom < (root.native-source-width * 1px / preview.width) * 0.375 && root.viewer-zoom >= (root.native-source-width * 1px / preview.width) * 0.1875;
                                source: root.native-level-2-image;
                                width: parent.width * root.viewer-zoom;
                                height: parent.height * root.viewer-zoom;
                                x: -(self.width - parent.width) / 2 + root.viewer-pan-x * parent.width;
                                y: -(self.height - parent.height) / 2 + root.viewer-pan-y * parent.height;
                                image-fit: fill;
                            }

                            Image {
                                visible: root.native-pyramid-ready && root.viewer-zoom < (root.native-source-width * 1px / preview.width) * 0.1875;
                                source: root.native-level-3-image;
                                width: parent.width * root.viewer-zoom;
                                height: parent.height * root.viewer-zoom;
                                x: -(self.width - parent.width) / 2 + root.viewer-pan-x * parent.width;
                                y: -(self.height - parent.height) / 2 + root.viewer-pan-y * parent.height;
                                image-fit: fill;
                            }

                            Image {
                                visible: root.capture-rendering && root.native-staging-ready;
                                source: root.native-staging-image;
                                width: parent.width;
                                height: parent.height;
                                image-fit: fill;
                            }

                            Rectangle {
                                visible: root.view-index == 4 && root.render-quality-index >= 3 && !root.capture-rendering && (!root.native-capture-ready || root.native-capture-stale);
                                width: 260px;
                                height: 96px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: 7px;
                                border-width: 1px;
                                border-color: #40516a;
                                background: #111821e8;

                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    Text {
                                        text: root.native-capture-stale ? "CAMERA SETTINGS CHANGED" : "NATIVE CAPTURE NOT RENDERED";
                                        color: #92baff;
                                        horizontal-alignment: center;
                                    }
                                    Button {
                                        text: root.render-quality-index == 3 ? "Render native ROI" : "Render complete frame";
                                        clicked => { root.render-capture-frame(); }
                                    }
                                }
                            }

                            Rectangle {
                                visible: drag-area.pressed && root.zoom-key-held;
                                x: min(drag-area.pressed-x, drag-area.mouse-x);
                                y: min(drag-area.pressed-y, drag-area.mouse-y);
                                width: abs(drag-area.mouse-x - drag-area.pressed-x);
                                height: abs(drag-area.mouse-y - drag-area.pressed-y);
                                border-width: 2px;
                                border-color: #6da4ff;
                                background: #286fd82c;
                            }

                            drag-area := TouchArea {
                                mouse-cursor: root.zoom-key-held ? crosshair : (root.viewer-zoom > 1 ? move : default);
                                moved => {
                                    if (self.pressed && !root.zoom-key-held && root.viewer-zoom > 1) {
                                        root.viewer-pan-x = clamp(root.pan-start-x + (self.mouse-x - self.pressed-x) / preview.width, -(root.viewer-zoom - 1) / 2, (root.viewer-zoom - 1) / 2);
                                        root.viewer-pan-y = clamp(root.pan-start-y + (self.mouse-y - self.pressed-y) / preview.height, -(root.viewer-zoom - 1) / 2, (root.viewer-zoom - 1) / 2);
                                    }
                                }
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                        root.pan-start-x = root.viewer-pan-x;
                                        root.pan-start-y = root.viewer-pan-y;
                                    }
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.zoom-key-held && root.view-index != 4) {
                                        if (abs(self.mouse-x - self.pressed-x) >= 4px && abs(self.mouse-y - self.pressed-y) >= 4px) {
                                            root.inspect(
                                                self.pressed-x / preview.width,
                                                self.pressed-y / preview.height,
                                                self.mouse-x / preview.width,
                                                self.mouse-y / preview.height
                                            );
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        Rectangle {
                            height: 34px;
                            background: transparent;

                            Text {
                                text: root.error-text != "" ? root.error-text : root.hint-text;
                                color: root.error-text != "" ? #f28e6b : #718098;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    width: 334px;
                    background: #151922;
                    border-width: 1px;
                    border-color: #303744;

                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: root.render-quality-index >= 3 ? 258px : 196px;
                            background: #171c25;
                            border-width: 1px;
                            border-color: #303744;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;

                                Text {
                                    text: "SCENE INSPECTOR";
                                    color: #e2e8f2;
                                    font-size: 13px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    height: 32px;
                                    Text { text: "View"; color: #aeb7c8; width: 78px; vertical-alignment: center; }
                                    ComboBox {
                                        model: ["Composite", "Device signal", "RGB subpixels", "Emitted radiance", "Camera result"];
                                        current-index <=> root.view-index;
                                    }
                                }

                                HorizontalLayout {
                                    height: 32px;
                                    Text { text: "Camera"; color: #aeb7c8; width: 78px; vertical-alignment: center; }
                                    ComboBox {
                                        model: root.capture-preset-model;
                                        current-index <=> root.capture-preset-index;
                                        selected(value) => {
                                            root.select-capture-preset(root.capture-preset-ids[self.current-index]);
                                        }
                                    }
                                }

                                Text {
                                    text: root.capture-summary;
                                    color: #8794a9;
                                    font-size: 10px;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    height: 32px;
                                    Text { text: "Quality"; color: #aeb7c8; width: 78px; vertical-alignment: center; }
                                    ComboBox {
                                        model: ["Draft", "Medium", "High", "Native · 1024 px sensor crop", "Native · complete frame"];
                                        current-index <=> root.render-quality-index;
                                        selected(value) => { root.select-render-quality(self.current-index); }
                                    }
                                }

                                HorizontalLayout {
                                    visible: root.render-quality-index >= 3;
                                    height: 34px;
                                    spacing: 8px;
                                    Button {
                                        text: root.render-quality-index == 3 ? "Render native ROI" : "Render full frame";
                                        clicked => { root.render-capture-frame(); }
                                        enabled: !root.capture-rendering;
                                        horizontal-stretch: 1;
                                    }
                                    Button {
                                        text: "Cancel";
                                        clicked => { root.cancel-capture-frame(); }
                                        visible: root.capture-rendering;
                                    }
                                }

                                Button {
                                    visible: root.render-quality-index >= 3 && root.native-capture-ready;
                                    text: "Export exact Native PNG…";
                                    clicked => { root.export-native-frame(); }
                                    enabled: !root.capture-rendering && !root.native-capture-stale;
                                    height: 32px;
                                }

                                Text {
                                    visible: root.render-quality-index >= 3;
                                    text: root.capture-rendering ? root.render-progress-label : (root.native-capture-stale ? "Previous complete frame · stale" : (root.native-capture-ready ? "Complete frame available" : "Ready to render one explicit frame"));
                                    color: root.capture-rendering ? #8fc6ff : #8794a9;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                        }

                        ScrollView {
                            vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                        VerticalLayout {
                            padding: 18px;
                            padding-right: 24px;
                            spacing: 5px;

                        HorizontalLayout {
                            height: 30px;
                            Text { text: "SOURCE"; color: #71819b; font-size: 11px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: "Open…"; clicked => { root.choose-source(); } }
                        }
                        Text { text: root.source-title; color: #c3ccda; overflow: elide; }
                        Text { text: root.source-details; color: #8794a9; overflow: elide; }
                        Text { text: root.source-interpretation; color: #d59b68; overflow: elide; }

                        HorizontalLayout {
                            visible: root.procedural-source;
                            height: 34px;
                            Text { text: "Test chart"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: ["Animated checkerboard", "Eye chart · black on white", "Editorial text · common sizes", "Camera color · skin and materials", "Frequency · MTF and moire", "Photometric gray · device codes", "VFX photographed-screen comparison"];
                                current-index <=> root.procedural-pattern-index;
                            }
                        }

                        HorizontalLayout {
                            height: 34px;
                            Text { text: "YUV matrix"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: ["Auto (metadata)", "Rec.709", "Rec.601", "Rec.2020"];
                                current-index <=> root.matrix-index;
                            }
                        }

                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Signal range"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: ["Auto (metadata)", "Limited", "Full"];
                                current-index <=> root.range-index;
                            }
                        }

                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Input Transform"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: root.idt-model;
                                current-index <=> root.idt-index;
                            }
                        }

                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Alpha"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: ["Auto (metadata)", "Straight", "Premultiplied", "Ignore · opaque"];
                                current-index <=> root.alpha-index;
                            }
                        }

                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Sampling"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: ["Exact", "Floor · hold edges", "Nearest · hold edges"];
                                current-index <=> root.sample-policy-index;
                            }
                        }

                        Text {
                            text: "Alpha target · opaque black";
                            color: #71819b;
                            font-size: 11px;
                        }

                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Placement"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: ["Fit", "Fill / Crop", "Stretch", "1:1"];
                                current-index <=> root.placement-index;
                            }
                        }
                        Rectangle { height: 1px; background: #303744; }

                        Text { text: "PHYSICAL PIPELINE"; color: #71819b; font-size: 11px; }
                        Text {
                            text: "0 = ideal · 1 = calibrated · >1 = artistic";
                            color: #8794a9;
                            font-size: 10px;
                        }

                        Rectangle {
                            height: 166px;
                            background: #171c24;
                            border-width: 1px;
                            border-color: #303744;
                            border-radius: 5px;

                            VerticalLayout {
                                padding: 6px;
                                spacing: 0px;

                                ValueRow {
                                    label: "Panel";
                                    minimum: 0;
                                    maximum: 4;
                                    step: 0.01;
                                    value <=> root.panel-character-strength;
                                    numeric-value: round(root.panel-character-strength * 100) / 100;
                                }
                                ValueRow {
                                    label: "Glass";
                                    minimum: 0;
                                    maximum: 2;
                                    step: 0.01;
                                    value <=> root.cover-strength;
                                    numeric-value: round(root.cover-strength * 100) / 100;
                                }
                                ValueRow {
                                    label: "Environment";
                                    minimum: 0;
                                    maximum: 4;
                                    step: 0.01;
                                    value <=> root.environment-strength;
                                    numeric-value: round(root.environment-strength * 100) / 100;
                                }
                                ValueRow {
                                    label: "Lens";
                                    minimum: 0;
                                    maximum: 4;
                                    step: 0.01;
                                    value <=> root.lens-character-strength;
                                    numeric-value: round(root.lens-character-strength * 100) / 100;
                                }
                            }
                        }

                        Text { text: "1 · PANEL EMISSION"; color: #8fc6ff; font-size: 10px; }

                        ValueRow {
                            label: "Flicker";
                            minimum: 0;
                            maximum: 10;
                            step: 0.1;
                            value <=> root.panel-flicker-percent;
                            numeric-value: round(root.panel-flicker-percent * 10) / 10;
                            suffix: "%";
                        }

                        ValueRow {
                            label: "Flicker rate";
                            minimum: 10;
                            maximum: 4000;
                            step: 1;
                            value <=> root.panel-flicker-hz;
                            numeric-value: round(root.panel-flicker-hz);
                            suffix: "Hz";
                        }

                        ValueRow {
                            label: "Banding";
                            minimum: 0;
                            maximum: 1;
                            step: 0.01;
                            value <=> root.panel-banding-amount;
                            numeric-value: round(root.panel-banding-amount * 100) / 100;
                        }

                        ValueRow {
                            label: "Band rate";
                            minimum: 10;
                            maximum: 4000;
                            step: 1;
                            value <=> root.panel-banding-hz;
                            numeric-value: round(root.panel-banding-hz);
                            suffix: "Hz";
                            visible: root.panel-banding-amount > 0;
                        }

                        ValueRow {
                            label: "Band duty";
                            minimum: 1;
                            maximum: 100;
                            step: 1;
                            value <=> root.panel-banding-duty-percent;
                            numeric-value: round(root.panel-banding-duty-percent);
                            suffix: "%";
                            visible: root.panel-banding-amount > 0;
                        }

                        Text { text: "2 · COVER + ENVIRONMENT"; color: #8fc6ff; font-size: 10px; }
                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Glass"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: root.cover-preset-model;
                                current-index <=> root.cover-preset-index;
                                selected(value) => {
                                    root.select-cover-preset(root.cover-preset-ids[self.current-index]);
                                }
                            }
                        }
                        Text { text: root.cover-summary; color: #8794a9; font-size: 10px; overflow: elide; }

                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Environment"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: root.environment-preset-model;
                                current-index <=> root.environment-preset-index;
                                selected(value) => {
                                    root.select-environment-preset(root.environment-preset-ids[self.current-index]);
                                }
                            }
                        }
                        Text { text: root.environment-summary; color: #8794a9; font-size: 10px; overflow: elide; }
                        ValueRow {
                            label: "Env rotation X";
                            minimum: -90;
                            maximum: 90;
                            step: 1;
                            value <=> root.environment-rotation-x-degrees;
                            numeric-value: round(root.environment-rotation-x-degrees * 10) / 10;
                            suffix: "°";
                        }
                        ValueRow {
                            label: "Env rotation Y";
                            minimum: -180;
                            maximum: 180;
                            step: 1;
                            value <=> root.environment-rotation-y-degrees;
                            numeric-value: round(root.environment-rotation-y-degrees * 10) / 10;
                            suffix: "°";
                        }

                        Text { text: "3 · LENS"; color: #8fc6ff; font-size: 10px; }
                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Lens"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: root.lens-preset-model;
                                current-index <=> root.lens-preset-index;
                                enabled: !root.capture-fixed-optics;
                                selected(value) => {
                                    root.select-lens-preset(root.lens-preset-ids[self.current-index]);
                                }
                            }
                        }
                        Text { text: root.lens-summary; color: #8794a9; font-size: 10px; overflow: elide; }

                        Text { text: "4 · SENSOR CFA + DEMOSAIC"; color: #8fc6ff; font-size: 10px; }
                        Text {
                            text: "Discrete physical stage · intermediate taps pending";
                            color: #8794a9;
                            font-size: 10px;
                        }

                        Rectangle { height: 1px; background: #303744; }

                        Text { text: "DEVICE"; color: #71819b; font-size: 11px; }

                        ComboBox {
                            model: root.device-preset-model;
                            current-index <=> root.device-preset-index;
                            selected(value) => {
                                root.select-device-preset(root.device-preset-ids[self.current-index]);
                            }
                        }

                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Color Mode"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: root.color-mode-model;
                                current-index <=> root.color-mode-index;
                            }
                        }

                        Text {
                            text: root.device-native-width + " × " + root.device-native-height + " px · " + root.device-active-width-mm + " × " + root.device-active-height-mm + " mm";
                            color: #c3ccda;
                            font-size: 11px;
                        }

                        Text { text: root.device-summary; color: #8794a9; font-size: 11px; }

                        Text {
                            text: root.device-white-basis + " · " + round(root.device-reference-white-nits) + " nit" + (abs(root.white-nits - root.device-reference-white-nits) > 0.05 ? " · modified" : "");
                            color: abs(root.white-nits - root.device-reference-white-nits) > 0.05 ? #d59b68 : #8794a9;
                            font-size: 11px;
                        }

                        ValueRow {
                            visible: root.device-preset-index == root.device-preset-model.length - 1;
                            label: "Width px";
                            minimum: 320;
                            maximum: 8192;
                            step: 1;
                            value <=> root.device-native-width;
                            numeric-value: round(root.device-native-width);
                        }

                        ValueRow {
                            visible: root.device-preset-index == root.device-preset-model.length - 1;
                            label: "Height px";
                            minimum: 240;
                            maximum: 8192;
                            step: 1;
                            value <=> root.device-native-height;
                            numeric-value: round(root.device-native-height);
                        }

                        ValueRow {
                            visible: root.device-preset-index == root.device-preset-model.length - 1;
                            label: "Width";
                            minimum: 40;
                            maximum: 2000;
                            step: 0.1;
                            value <=> root.device-active-width-mm;
                            numeric-value: round(root.device-active-width-mm * 10) / 10;
                            suffix: "mm";
                        }

                        ValueRow {
                            visible: root.device-preset-index == root.device-preset-model.length - 1;
                            label: "Height";
                            minimum: 40;
                            maximum: 1200;
                            step: 0.1;
                            value <=> root.device-active-height-mm;
                            numeric-value: round(root.device-active-height-mm * 10) / 10;
                            suffix: "mm";
                        }

                        Rectangle { height: 1px; background: #303744; }

                        Text { text: "LCD PANEL"; color: #71819b; font-size: 11px; }

                        ValueRow {
                            label: "White Luminance";
                            minimum: 100;
                            maximum: 1500;
                            step: 1;
                            value <=> root.white-nits;
                            numeric-value: round(root.white-nits);
                            suffix: "nit";
                        }

                        ValueRow {
                            label: "EOTF γ";
                            minimum: 1.6;
                            maximum: 2.8;
                            step: 0.01;
                            value <=> root.gamma;
                            numeric-value: round(root.gamma * 100) / 100;
                        }

                        ValueRow {
                            label: "Black matrix";
                            minimum: 0.02;
                            maximum: 0.30;
                            step: 0.01;
                            value <=> root.black-matrix;
                            numeric-value: round(root.black-matrix * 100) / 100;
                        }

                        HorizontalLayout {
                            height: 34px;

                            Text {
                                text: "Stripe order";
                                color: #aeb7c8;
                                width: 94px;
                                vertical-alignment: center;
                            }

                            ComboBox {
                                model: ["RGB", "BGR"];
                                current-index <=> root.stripe-index;
                            }
                        }

                        Rectangle { height: 1px; background: #303744; }
                        Text { text: "CAMERA"; color: #71819b; font-size: 11px; }

                        ValueRow {
                            label: "Distance";
                            minimum: 0.05;
                            maximum: 20;
                            step: 0.01;
                            value <=> root.distance-m;
                            numeric-value: round(root.distance-m * 100) / 100;
                            suffix: "m";
                        }

                        ValueRow {
                            label: "Focal";
                            minimum: 4;
                            maximum: 135;
                            step: 0.1;
                            value <=> root.focal-mm;
                            numeric-value: round(root.focal-mm * 10) / 10;
                            suffix: "mm";
                            enabled: !root.capture-fixed-optics;
                        }

                        ValueRow {
                            label: "Orbit yaw";
                            minimum: -45;
                            maximum: 35;
                            step: 0.1;
                            value <=> root.yaw-degrees;
                            numeric-value: round(root.yaw-degrees * 10) / 10;
                            suffix: "°";
                        }

                        ValueRow {
                            label: "Orbit pitch";
                            minimum: -35;
                            maximum: 35;
                            step: 0.1;
                            value <=> root.pitch-degrees;
                            numeric-value: round(root.pitch-degrees * 10) / 10;
                            suffix: "°";
                        }

                        ValueRow {
                            label: "Focus";
                            minimum: 0.05;
                            maximum: 20;
                            step: 0.01;
                            value <=> root.focus-distance-m;
                            numeric-value: round(root.focus-distance-m * 100) / 100;
                            suffix: "m";
                            enabled: root.focus-mode-index == 1;
                        }

                        HorizontalLayout {
                            height: 34px;
                            Text { text: "Focus mode"; color: #aeb7c8; width: 94px; vertical-alignment: center; }
                            ComboBox {
                                model: ["Panel", "Manual"];
                                current-index <=> root.focus-mode-index;
                            }
                        }

                        ValueRow {
                            label: "F-stop";
                            minimum: 1.0;
                            maximum: 22;
                            step: 0.1;
                            value <=> root.f-stop;
                            numeric-value: round(root.f-stop * 10) / 10;
                        }

                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            ComboBox {
                                model: ["Hold", "Linear", "Smooth"];
                                current-index <=> root.camera-interpolation-index;
                            }
                            Button {
                                text: (root.camera-edit-pending ? "Commit key · " : "Set key · ") + root.camera-key-count;
                                clicked => { root.set-camera-keyframe(); }
                            }
                        }

                        HorizontalLayout {
                            height: 30px;

                            Text {
                                text: "Sensor";
                                color: #aeb7c8;
                                width: 94px;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: round(root.capture-gate-width-mm * 100) / 100 + " × " + round(root.capture-gate-height-mm * 100) / 100 + " mm";
                                color: #c3ccda;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: #303744; }
                        Text { text: "VIEW SETTINGS"; color: #71819b; font-size: 11px; }

                        ValueRow {
                            label: "Preview EV";
                            minimum: -4;
                            maximum: 12;
                            step: 0.1;
                            value <=> root.preview-exposure-ev;
                            numeric-value: round(root.preview-exposure-ev * 10) / 10;
                            suffix: "EV";
                            visible: root.view-index != 4;
                        }

                        Text {
                            text: "CAPTURE SETTINGS";
                            color: #71819b;
                            font-size: 11px;
                            visible: root.view-index == 4;
                        }

                        ValueRow {
                            label: "EI / ISO";
                            minimum: 25;
                            maximum: 12800;
                            step: 25;
                            value <=> root.capture-exposure-index;
                            numeric-value: round(root.capture-exposure-index);
                            visible: root.view-index == 4;
                        }

                        ValueRow {
                            label: "Shutter";
                            minimum: 1;
                            maximum: 360;
                            step: 1;
                            value <=> root.shutter-angle-degrees;
                            numeric-value: round(root.shutter-angle-degrees * 10) / 10;
                            suffix: "°";
                            visible: root.view-index == 4;
                        }

                        ComboBox {
                            visible: root.view-index == 4;
                            model: ["Global", "Rolling top → bottom", "Rolling bottom → top"];
                            current-index <=> root.sensor-readout-index;
                        }

                        ValueRow {
                            label: "Readout";
                            minimum: 0.1;
                            maximum: 100;
                            step: 0.1;
                            value <=> root.readout-duration-ms;
                            numeric-value: round(root.readout-duration-ms * 10) / 10;
                            suffix: "ms";
                            visible: root.view-index == 4 && root.sensor-readout-index != 0;
                        }

                        ValueRow {
                            label: "Motion samples";
                            minimum: 1;
                            maximum: 64;
                            step: 1;
                            value <=> root.temporal-samples;
                            numeric-value: round(root.temporal-samples);
                            visible: root.view-index == 4;
                        }

                        ValueRow {
                            label: "Noise seed";
                            minimum: 0;
                            maximum: 16777215;
                            step: 1;
                            value <=> root.sensor-noise-seed;
                            numeric-value: round(root.sensor-noise-seed);
                            visible: root.view-index == 4;
                        }

                        ValueRow {
                            label: "Optical ND";
                            minimum: 0;
                            maximum: 16;
                            step: 0.1;
                            value <=> root.neutral-density-stops;
                            numeric-value: round(root.neutral-density-stops * 10) / 10;
                            suffix: "EV";
                            visible: root.view-index == 4;
                        }

                        ValueRow {
                            visible: root.view-index == 4 && root.capture-preset-index == root.capture-preset-model.length - 1;
                            label: "Sensor W";
                            minimum: 64;
                            maximum: 12000;
                            step: 1;
                            value <=> root.capture-sensor-width;
                            numeric-value: round(root.capture-sensor-width);
                            suffix: "px";
                        }

                        ValueRow {
                            visible: root.view-index == 4 && root.capture-preset-index == root.capture-preset-model.length - 1;
                            label: "Sensor H";
                            minimum: 64;
                            maximum: 12000;
                            step: 1;
                            value <=> root.capture-sensor-height;
                            numeric-value: round(root.capture-sensor-height);
                            suffix: "px";
                        }

                        ValueRow {
                            visible: root.view-index == 4 && root.capture-preset-index == root.capture-preset-model.length - 1;
                            label: "Gate W";
                            minimum: 1;
                            maximum: 70;
                            step: 0.01;
                            value <=> root.capture-gate-width-mm;
                            numeric-value: round(root.capture-gate-width-mm * 100) / 100;
                            suffix: "mm";
                        }

                        ValueRow {
                            visible: root.view-index == 4 && root.capture-preset-index == root.capture-preset-model.length - 1;
                            label: "Gate H";
                            minimum: 1;
                            maximum: 70;
                            step: 0.01;
                            value <=> root.capture-gate-height-mm;
                            numeric-value: round(root.capture-gate-height-mm * 100) / 100;
                            suffix: "mm";
                        }

                        Text {
                            text: root.capture-sensor-width + " × " + root.capture-sensor-height + " · " + root.capture-gate-width-mm + " × " + root.capture-gate-height-mm + " mm";
                            color: #c3ccda;
                            font-size: 11px;
                            visible: root.view-index == 4;
                        }

                        ValueRow {
                            label: "WB red";
                            minimum: 0.25;
                            maximum: 4;
                            step: 0.01;
                            value <=> root.white-balance-r;
                            numeric-value: round(root.white-balance-r * 100) / 100;
                            visible: root.view-index == 4;
                        }

                        ValueRow {
                            label: "WB green";
                            minimum: 0.25;
                            maximum: 4;
                            step: 0.01;
                            value <=> root.white-balance-g;
                            numeric-value: round(root.white-balance-g * 100) / 100;
                            visible: root.view-index == 4;
                        }

                        ValueRow {
                            label: "WB blue";
                            minimum: 0.25;
                            maximum: 4;
                            step: 0.01;
                            value <=> root.white-balance-b;
                            numeric-value: round(root.white-balance-b * 100) / 100;
                            visible: root.view-index == 4;
                        }

                        ValueRow {
                            label: "Develop";
                            minimum: -8;
                            maximum: 8;
                            step: 0.1;
                            value <=> root.camera-exposure-ev;
                            numeric-value: round(root.camera-exposure-ev * 10) / 10;
                            suffix: "EV";
                            visible: root.view-index == 4;
                        }

                        ComboBox {
                            model: ["ACES 2.0 · sRGB SDR 100", "ACES 2.0 · Rec.709 SDR 100", "ACES 2.0 · Rec.2100 PQ 1000"];
                            current-index <=> root.output-transform-index;
                            visible: root.view-index == 4;
                        }

                        Text {
                            text: "Screen Simulation 0.1.0";
                            color: #66748a;
                            font-size: 11px;
                        }
                    }
                }
                }
            }
            }

            Rectangle {
                height: root.render-progress-visible ? 34px : 0px;
                visible: root.render-progress-visible;
                background: #111720;
                border-width: 1px;
                border-color: #2a3442;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;

                    Text {
                        text: root.render-progress-label;
                        color: #b9c5d8;
                        width: 250px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: #27303d;
                        horizontal-stretch: 1;

                        Rectangle {
                            width: parent.width * clamp(root.render-progress, 0, 1);
                            height: parent.height;
                            border-radius: 4px;
                            background: #55b7f3;
                        }
                    }

                    Text {
                        text: round(clamp(root.render-progress, 0, 1) * 100) + "%";
                        color: #8fa0b8;
                        width: 44px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    Button {
                        text: "Cancel";
                        visible: root.capture-rendering;
                        clicked => { root.cancel-capture-frame(); }
                    }
                }
            }

            Rectangle {
                height: 70px;
                background: #141820;
                border-width: 1px;
                border-color: #2a303b;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 12px;

                    Button {
                        text: root.playing ? "Pause" : "Play";
                        clicked => {
                            root.playing = !root.playing;
                        }
                    }

                    Text {
                        text: "Frame " + root.frame-number + " / 96";
                        color: #d4dce9;
                        vertical-alignment: center;
                        width: 110px;
                    }

                    Slider {
                        minimum: 0;
                        maximum: 96;
                        step: 1;
                        value: root.frame-number;
                        changed(value) => {
                            root.frame-number = round(value);
                        }
                    }

                    Text { text: "Project FPS"; color: #77859b; vertical-alignment: center; }

                    ComboBox {
                        width: 150px;
                        model: ["23.976", "24", "25", "29.97", "30", "50", "59.94", "60", "Custom"];
                        current-index <=> root.project-fps-index;
                    }

                    Rectangle {
                        visible: root.project-fps-index == 8;
                        width: 120px;
                        height: 30px;
                        background: #252b35;
                        border-width: 1px;
                        border-color: #454d5c;
                        border-radius: 4px;

                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            TextInput {
                                text: root.custom-fps-numerator;
                                input-type: number;
                                color: #e6ebf3;
                                horizontal-alignment: right;
                                single-line: true;
                                accepted => {
                                    if (self.text.is-float()) {
                                        root.custom-fps-numerator = round(self.text.to-float());
                                    }
                                }
                            }
                            Text { text: "/"; color: #77859b; vertical-alignment: center; }
                            TextInput {
                                text: root.custom-fps-denominator;
                                input-type: number;
                                color: #e6ebf3;
                                horizontal-alignment: right;
                                single-line: true;
                                accepted => {
                                    if (self.text.is-float()) {
                                        root.custom-fps-denominator = round(self.text.to-float());
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
