{
  "schema": "screen_simulation_validation_owners",
  "version": 1,
  "owners": [
    {
      "id": "repository-contract",
      "paths": [
        ".gitignore",
        "AGENTS.md",
        "Cargo.lock",
        "Cargo.toml",
        "README.md",
        "rust-toolchain.toml"
      ],
      "checks": ["architecture", "workspace"]
    },
    {
      "id": "architecture",
      "paths": [
        ".github/workflows/*.yml",
        "architecture/*.json",
        "Docs/architecture/*.md",
        "scripts/*.py"
      ],
      "checks": ["architecture", "workspace"]
    },
    {
      "id": "sealed-history",
      "paths": ["Docs/old/**"],
      "checks": ["archive-isolation"]
    },
    {
      "id": "contracts",
      "paths": ["crates/screen-contracts/**"],
      "checks": ["architecture", "workspace", "contracts"]
    },
    {
      "id": "media",
      "paths": ["crates/screen-media/**"],
      "checks": ["architecture", "workspace", "media"]
    },
    {
      "id": "color",
      "paths": ["crates/screen-color/**"],
      "checks": ["architecture", "workspace", "color"]
    },
    {
      "id": "panel",
      "paths": ["crates/screen-panel/**"],
      "checks": ["architecture", "workspace", "panel"]
    },
    {
      "id": "optical-cover",
      "paths": ["crates/screen-cover/**"],
      "checks": ["architecture", "workspace", "optical-cover"]
    },
    {
      "id": "geometry",
      "paths": ["crates/screen-geometry/**"],
      "checks": ["architecture", "workspace", "geometry"]
    },
    {
      "id": "sensor",
      "paths": ["crates/screen-sensor/**"],
      "checks": ["architecture", "workspace", "sensor"]
    },
    {
      "id": "camera-development",
      "paths": ["crates/screen-camera/**"],
      "checks": ["architecture", "workspace", "camera-development"]
    },
    {
      "id": "application",
      "paths": ["crates/screen-application/**"],
      "checks": ["architecture", "workspace", "application"]
    },
    {
      "id": "persistence",
      "paths": ["crates/screen-persistence/**"],
      "checks": ["architecture", "workspace", "persistence"]
    },
    {
      "id": "platform",
      "paths": ["crates/screen-platform/**"],
      "checks": ["architecture", "workspace", "platform"]
    },
    {
      "id": "studio-color",
      "paths": ["packages/StudioColor/**"],
      "checks": ["architecture", "studio-color"]
    },
    {
      "id": "studio-media",
      "paths": ["packages/StudioMedia/**"],
      "checks": ["architecture", "studio-media"]
    },
    {
      "id": "native-macos-composition",
      "paths": ["apps/screen-native-macos/**", "crates/screen-native-bridge/**", "Docs/NATIVE_MACOS_CUTOVER.md", "Docs/NATIVE_IO_METAL_PHASE.md", "Docs/NATIVE_COLOR_IDENTITY_REPORT.md", "Docs/NATIVE_DEVICE_PHASE.md", "Docs/NATIVE_PHYSICAL_FRAME_CONTRACT.md", "Docs/NATIVE_PHYSICAL_INTEGRATION_REPORT.md", "Docs/NATIVE_PHYSICAL_PARITY_AUDIT.md", "Docs/NATIVE_PHYSICAL_PIPELINE_V2.md", "Docs/NATIVE_PHYSICAL_UI_FIELD_MATRIX.md"],
      "checks": ["architecture", "workspace", "native-macos"]
    },
    {
      "id": "desktop-composition",
      "paths": ["apps/screen-desktop/**"],
      "checks": ["architecture", "workspace", "desktop"]
    }
  ]
}
