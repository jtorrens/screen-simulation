{
  "schema": "screen_simulation_validation_owners",
  "version": 1,
  "owners": [
    {
      "id": "repository-contract",
      "paths": [
        ".gitignore",
        ".gitmodules",
        "AGENTS.md",
        "Cargo.lock",
        "Cargo.toml",
        "README.md",
        "rust-toolchain.toml"
      ],
      "checks": ["architecture", "workspace"]
    },
    {
      "id": "architecture",
      "paths": [
        ".github/workflows/*.yml",
        "architecture/*.json",
        "Docs/MATCH_REFERENCE_MODE_PROPOSAL.md",
        "Docs/architecture/*.md",
        "scripts/*.py"
      ],
      "checks": ["architecture", "workspace"]
    },
    {
      "id": "project-handoff",
      "paths": ["work/shot_manager_phase_1_handoff.md"],
      "checks": ["architecture"]
    },
    {
      "id": "sealed-history",
      "paths": ["Docs/old/**"],
      "checks": ["archive-isolation"]
    },
    {
      "id": "contracts",
      "paths": ["crates/screen-contracts/**"],
      "checks": ["architecture", "workspace", "contracts"]
    },
    {
      "id": "media",
      "paths": ["crates/screen-media/**"],
      "checks": ["architecture", "workspace", "media"]
    },
    {
      "id": "color",
      "paths": ["crates/screen-color/**"],
      "checks": ["architecture", "workspace", "color"]
    },
    {
      "id": "panel",
      "paths": ["crates/screen-panel/**"],
      "checks": ["architecture", "workspace", "panel"]
    },
    {
      "id": "optical-cover",
      "paths": ["crates/screen-cover/**"],
      "checks": ["architecture", "workspace", "optical-cover"]
    },
    {
      "id": "geometry",
      "paths": ["crates/screen-geometry/**"],
      "checks": ["architecture", "workspace", "geometry"]
    },
    {
      "id": "sensor",
      "paths": ["crates/screen-sensor/**"],
      "checks": ["architecture", "workspace", "sensor"]
    },
    {
      "id": "camera-development",
      "paths": ["crates/screen-camera/**"],
      "checks": ["architecture", "workspace", "camera-development"]
    },
    {
      "id": "recording-codec",
      "paths": ["crates/screen-recording/**"],
      "checks": ["architecture", "workspace", "recording-codec"]
    },
    {
      "id": "application",
      "paths": ["crates/screen-application/**"],
      "checks": ["architecture", "workspace", "application"]
    },
    {
      "id": "persistence",
      "paths": ["crates/screen-persistence/**"],
      "checks": ["architecture", "workspace", "persistence"]
    },
    {
      "id": "platform",
      "paths": ["crates/screen-platform/**"],
      "checks": ["architecture", "workspace", "platform"]
    },
    {
      "id": "studio-color",
      "paths": ["packages/StudioColor/**"],
      "checks": ["architecture", "studio-color"]
    },
    {
      "id": "studio-media",
      "paths": ["packages/StudioMedia/**"],
      "checks": ["architecture", "studio-media"]
    },
    {
      "id": "presentation-contracts",
      "paths": [
        "apps/screen-native-macos/Sources/ScreenSimulationPresentation/**",
        "apps/screen-native-macos/Tests/ScreenSimulationPresentationTests/**"
      ],
      "checks": ["architecture", "presentation-contracts", "native-macos"]
    },
    {
      "id": "macos-presentation",
      "paths": [
        "apps/screen-native-macos/Sources/ScreenSimulationMacUI/**"
      ],
      "checks": ["architecture", "macos-presentation", "native-macos"]
    },
    {
      "id": "native-macos-composition",
      "paths": ["apps/screen-native-macos/Package.swift", "apps/screen-native-macos/Package.resolved", "apps/screen-native-macos/Assets/**", "apps/screen-native-macos/Sources/ScreenPhysicalBridge/**", "apps/screen-native-macos/Sources/ScreenSimulationNative/**", "apps/screen-native-macos/Tests/ScreenSimulationNativeTests/**", "crates/screen-native-bridge/**", "tools/wip-ofx-host/**", "vendor/openfx", "validation/vfx/**", "Docs/CAPTURE_RADIOMETRIC_CALIBRATION.md", "Docs/EDITORIAL_DEVICE_PASSES_HANDOFF.md", "Docs/NATIVE_IO_METAL_PHASE.md", "Docs/NATIVE_COLOR_IDENTITY_REPORT.md", "Docs/NATIVE_DEVICE_PHASE.md", "Docs/NATIVE_PHYSICAL_FRAME_CONTRACT.md", "Docs/NATIVE_PHYSICAL_INTEGRATION_REPORT.md", "Docs/NATIVE_PHYSICAL_PARITY_AUDIT.md", "Docs/NATIVE_PHYSICAL_PIPELINE_V3.md", "Docs/NATIVE_PHYSICAL_UI_FIELD_MATRIX.md", "Docs/RADIOMETRIC_PATCH_VALIDATION.md", "Docs/RENDER_OPTIMIZATION_HANDOFF_2026-08-22.md"],
      "checks": ["architecture", "workspace", "native-macos"]
    },
    {
      "id": "desktop-composition",
      "paths": ["apps/screen-desktop/**"],
      "checks": ["architecture", "workspace", "desktop"]
    },
    {
      "id": "ofx-adapter",
      "paths": ["crates/screen-ofx-bridge/**", "ofx/screen-simulation/**"],
      "checks": ["architecture", "workspace", "ofx-origin"]
    }
  ]
}
